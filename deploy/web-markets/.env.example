# Markets web deploy env (build-time NEXT_PUBLIC_*)
# Copy to apps/web/.env.local for local dev or set in Vercel/host env for deploy.

NEXT_PUBLIC_PRODUCT=markets
NEXT_PUBLIC_API_BASE_URL=https://api.example.com
# Alias supported by apps/web runtime helper:
# NEXT_PUBLIC_API_URL=https://api.example.com

NEXT_PUBLIC_REOWN_PROJECT_ID=
NEXT_PUBLIC_CHAIN_ID=137

# Local full stack: pnpm dev:markets-stack (sets NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8080 in compose build)
