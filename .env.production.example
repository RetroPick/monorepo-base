# RetroPick Markets V1 staging/production example (no secrets).
# Copy to `.env.production` on the VPS before `scripts/compose-production.sh up -d --build`.
# For canonical staging topology see docker-compose.markets-staging.yml.

ENVIRONMENT=production

POSTGRES_DB=retropick
POSTGRES_USER=retropick
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://retropick:change-me@postgres:5432/retropick?sslmode=disable

# Markets BFF
PORT=8080
MARKETS_HTTP_PORT=8080
MARKETS_AUTH_SESSION_SECRET=change-me-min-32-chars
MARKETS_AUTH_ALLOWED_DOMAINS=your-api.example.com
MARKETS_AUTH_COOKIE_SECURE=1
MARKETS_AUTH_COOKIE_SAMESITE=Lax
MARKETS_CORS_ALLOWED_ORIGINS=https://your-app.example.com
MARKETS_REALTIME_ENABLED=1
MARKETS_REALTIME_ALLOWED_ORIGINS=https://your-app.example.com
MARKETS_GEOIP_BASE_URL=
MARKETS_GEOIP_PATH=/{ip}/json
MARKETS_GEOIP_API_KEY=
MARKETS_GEOBLOCK_BASE_URL=
MARKETS_GEOBLOCK_PATH=/api/geoblock
TRUSTED_PROXY_CIDRS=172.16.0.0/12,127.0.0.0/8,10.0.0.0/8
MARKETS_ORDER_SUBMIT_ENABLED=false
MARKETS_PORTFOLIO_READ_ENABLED=false
API_DB_MAX_CONNS=8
API_DB_MIN_CONNS=2

# Nginx TLS (production compose)
API_HOST=api.your-domain.example
APP_HOST=app.your-domain.example
NEXT_PUBLIC_API_BASE_URL=https://api.your-domain.example
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Optional full-VPS profile (markets-web service)
# NEXT_PUBLIC_API_BASE_URL must match public API origin seen by browsers.
