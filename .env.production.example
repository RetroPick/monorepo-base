# RetroPick production example for the canonical OrangeVPS/Vercel split stack.
# Copy to `.env.production` on the VPS and fill secrets before `scripts/compose-production.sh up -d --build`.

ENVIRONMENT=production

POSTGRES_DB=retropick
POSTGRES_USER=retropick
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://retropick:change-me@postgres:5432/retropick?sslmode=disable

RPC_URL=https://mainnet.base.org
RPC_FALLBACK_URLS=https://base-rpc.publicnode.com

PORT=8080
LOG_LEVEL=info
LIVE_RPC_TIMEOUT=15s
LIVE_RPC_GLOBAL_CACHE_TTL=5s

CORS_STRICT=1
CORS_ALLOWED_ORIGINS=https://app.example.com,https://your-project.vercel.app
WS_ALLOWED_ORIGINS=https://app.example.com,https://your-project.vercel.app
# Restrict X-Forwarded-For trust to the Docker bridge used by nginx.
TRUSTED_PROXY_CIDRS=172.16.0.0/12
AUTH_COOKIE_DOMAIN=.example.com
AUTH_COOKIE_SECURE=1
AUTH_JWT_SECRET=change-me
AUTH_SESSION_SECRET=change-me

INDEXER_START_BLOCK=12345678
INDEXER_LOOKBACK_BLOCKS=500000
INDEXER_FINALITY_DEPTH=3
INDEXER_TICK_INTERVAL_MS=3s
INDEXER_MAX_BLOCKS_PER_TICK=10000
PRICE_POLL_INTERVAL=15s
PRICE_HEARTBEAT_INTERVAL=5m

API_DB_MAX_CONNS=8
API_DB_MIN_CONNS=2
INDEXER_DB_MAX_CONNS=4
INDEXER_DB_MIN_CONNS=1
PRICE_DB_MAX_CONNS=2
PRICE_DB_MIN_CONNS=1
FUNDING_DB_MAX_CONNS=4
FUNDING_DB_MIN_CONNS=1
KEEPER_DB_MAX_CONNS=2
KEEPER_DB_MIN_CONNS=0
ALERT_DB_MAX_CONNS=1
ALERT_DB_MIN_CONNS=0

KEEPER_ENABLED=1
KEEPER_PRIVATE_KEY_FILE=/run/secrets/keeper.key
KEEPER_POLL_INTERVAL=5s
KEEPER_RECEIPT_TIMEOUT=90s
KEEPER_MAX_RETRY_COUNT=3

ALERT_WEBHOOK_URL=https://hooks.slack.com/services/replace/me
ALERT_POLL_INTERVAL=15s

SETTLEMENT_USDC_ADDRESS=0x0000000000000000000000000000000000000000
SETTLEMENT_RECEIVER_ADDRESS=0x0000000000000000000000000000000000000000
LIFI_WEBHOOK_SECRET=change-me

# Metrics are published to host loopback only via docker-compose.production.yml:
# 127.0.0.1:9090 api
# 127.0.0.1:9091 indexer
# 127.0.0.1:9092 keeper
# 127.0.0.1:9093 funding-worker
# 127.0.0.1:9094 price-worker

API_HOST=api.example.com
APP_HOST=app.example.com

NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_REOWN_PROJECT_ID=replace-me
