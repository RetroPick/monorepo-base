# Solana
SOLANA_RPC_URL=http://127.0.0.1:8899
SOLANA_WS_URL=ws://127.0.0.1:8900
SOLANA_WALLET_PATH=/home/YOUR_USER/.config/solana/id.json

# Programs
MARKET_REGISTRY_PROGRAM_ID=REPLACE_ME
ROUND_ENGINE_PROGRAM_ID=REPLACE_ME

# Database
DATABASE_URL=postgresql://retropick:retropick@localhost:5432/retropick

# Redis
REDIS_URL=redis://localhost:6379

# API
API_PORT=3001
API_HOST=0.0.0.0

# Worker
WORKER_CONCURRENCY=5

# Web
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8899
NEXT_PUBLIC_MARKET_REGISTRY_PROGRAM_ID=REPLACE_ME
NEXT_PUBLIC_ROUND_ENGINE_PROGRAM_ID=REPLACE_ME
NEXT_PUBLIC_API_URL=http://localhost:3001