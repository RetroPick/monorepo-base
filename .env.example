# RetroPick root environment template
#
# Copy values into local `.env` files as needed. Do not commit `.env`, `.env.local`,
# private keys, mnemonics, webhook secrets, or deploy credentials.

# Backend API
DATABASE_URL=postgres://retropick:retropick@127.0.0.1:5433/retropick?sslmode=disable
RPC_URL=https://sepolia.base.org
PORT=8080
LOG_LEVEL=info
CORS_STRICT=0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ALLOWED_ORIGIN_PATTERNS=
PUBLIC_BASE_URL=http://127.0.0.1:8080

# Backend auth and security
JWT_SECRET=
OPS_JWT_SECRET=
WEBHOOK_SECRET=
TRUSTED_PROXY_CIDRS=
RATE_LIMIT_ENABLED=1

# Backend database tuning
DB_MAX_CONNS=16
DB_MIN_CONNS=2
DB_HEALTH_CHECK_INTERVAL=30s

# Indexer
INDEXER_LOOKBACK_BLOCKS=50000
INDEXER_POLL_INTERVAL=5s
INDEXER_START_BLOCK=

# Keeper
KEEPER_ENABLED=0
KEEPER_DRY_RUN=1
KEEPER_POLL_INTERVAL=15s
KEEPER_PRIVATE_KEY=
KEEPER_SETTLEMENT_ADDRESS=

# Funding worker
FUNDING_WORKER_ENABLED=0
FUNDING_WORKER_POLL_INTERVAL=15s
FUNDING_PROVIDER=
FUNDING_WEBHOOK_SECRET=

# Price worker
PRICE_WORKER_ENABLED=0
PRICE_WORKER_POLL_INTERVAL=30s
PRICE_WORKER_LOOKBACK_MINUTES=240
PRICE_WORKER_MAX_FEEDS=50

# Metrics and alerts
METRICS_ENABLED=1
METRICS_PORT=9090
ALERT_WEBHOOK_URL=

# Faucet relay, Base Sepolia only
FAUCET_RELAY_ENABLED=0
FAUCET_RELAYER_PRIVATE_KEY=
FAUCET_RELAY_DEADLINE_MAX=15m

# Customer frontend
NEXT_PUBLIC_API_URL=http://127.0.0.1:8080
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8080/ws
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_MARKET_ENGINE_ADDRESS=
NEXT_PUBLIC_MARKET_REGISTRY_ADDRESS=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Vite compatibility for fe-v1 legacy routes/tests
VITE_API_URL=http://127.0.0.1:8080
VITE_WS_URL=ws://127.0.0.1:8080/ws
VITE_CHAIN_ID=84532
VITE_MARKET_ENGINE_ADDRESS=
VITE_MARKET_REGISTRY_ADDRESS=
VITE_WALLETCONNECT_PROJECT_ID=

# Ops app
OPS_API_BASE_URL=http://127.0.0.1:8080
OPS_JWT=
NEXT_PUBLIC_OPS_API_BASE_URL=http://127.0.0.1:8080
