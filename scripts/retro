#!/usr/bin/env bash
# retro — short entry to RETRODEPLOYER (V1 monorepo root). Same cwd rules as ./scripts/RETRODEPLOYER.
#
#   retro              → open menu
#   retro menu         → menu
#   retro d            → deploy-all
#   retro ro           → resume open batch
#   retro mon          → monitoring
#   retro routes       → templateId HTTP paths; activate-epoch, prepare-lock/resolve-epoch
#   retro e            → emergency prepare
#   retro p all        → prepare all
#   pnpm run retro     → from repo root
#
# On PATH: use ../bin/retro  (or  pnpm install  then  node_modules/.bin/retro)
set -euo pipefail

_script="$(readlink -f "${BASH_SOURCE[0]}")"
_RDIR="$(cd "$(dirname "$_script")" && pwd)"
V1_ROOT="$(cd "$_RDIR/.." && pwd)"
RETRO="$V1_ROOT/scripts/RETRODEPLOYER"
export V1_ROOT

if [[ ! -f "$RETRO" ]]; then
  echo "error: RETRODEPLOYER not found: $RETRO" >&2
  exit 1
fi

# No args: menu
if [[ $# -eq 0 ]]; then
  exec bash "$RETRO" menu
fi

cmd=$1
shift

case "$cmd" in
menu | m)
  exec bash "$RETRO" menu "$@"
  ;;
help | h | -h | --help)
  exec bash "$RETRO" help "$@"
  ;;
deploy | d)
  exec bash "$RETRO" deploy-all "$@"
  ;;
send | s)
  exec bash "$RETRO" send "$@"
  ;;
batch | bs)
  exec bash "$RETRO" batch-send "$@"
  ;;
launch | l)
  exec bash "$RETRO" launch "$@"
  ;;
open-all | oa)
  exec bash "$RETRO" prepare-open-all "$@"
  ;;
resume-open | ro)
  exec bash "$RETRO" resume-open "$@"
  ;;
monitor | mon)
  exec bash "$RETRO" monitor "$@"
  ;;
routes)
  exec bash "$RETRO" routes "$@"
  ;;
emergency | e)
  exec bash "$RETRO" emergency "$@"
  ;;
prepare | p)
  exec bash "$RETRO" prepare "$@"
  ;;
# passthrough: prepare-open-all, deploy-all, batch-send --yes, etc.
*)
  exec bash "$RETRO" "$cmd" "$@"
  ;;
esac
