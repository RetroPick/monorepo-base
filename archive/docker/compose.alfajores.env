# Alfajores V3 staging profile (see docs/upgrade-v3/demo-alfajores.md).
# Usage:
#   docker compose --env-file compose.alfajores.env up -d postgres migrator api indexer
#
# Do NOT enable V3 flags until registry.celo-alfajores.json has live addresses.

RETROPICK_COMPOSE_DATABASE_URL=postgres://retropick:retropick@postgres:5432/retropick?sslmode=disable

# Chain
RPC_URL=https://alfajores-forno.celo-testnet.org
CELO_CHAIN_ID=44787
CELO_RPC_URL=https://alfajores-forno.celo-testnet.org

# Registry — update after operator broadcast
REGISTRY_PATH=/app/packages/contracts/registry.celo-alfajores.json

# Indexer: set to MarketEngine deploy block after RC-1.1
INDEXER_START_BLOCK=0

# V3 flags — keep 0 until treasury broadcast (RC-1.2)
GOODDOLLAR_ENABLED=0
REFERRALS_ENABLED=0
REWARDS_ENABLED=0
IMPACT_ENABLED=0
FEE_ROUTER_ENABLED=0
# FEE_ROUTER_ADDRESS=0x...

# Frontend (host dev, not compose)
# VITE_GOODDOLLAR_ENABLED=1
