  DialogFooter,
  DialogHeader,
  DialogTitle,
} from "@/components/ui/dialog";
import { Progress } from "@/components/ui/progress";
import {
  HOW_RETRO_PICK_WORKS_STEPS,
  HOW_RETRO_PICK_WORKS_TITLE,
} from "@/lib/market-data/howRetroPickWorksContent";
