                    <td className="px-3 py-2 font-mono">{r.id}</td>
                    <td className="px-3 py-2">{r.action}</td>
                    <td className="px-3 py-2">{r.result}</td>
                    <td className="px-3 py-2 text-xs text-zinc-400">
                      {r.executedAt ?? "—"}
                    </td>
                  </tr>
                ))
              )}
            </tbody>
          </table>
        </div>
      </section>
    </div>
  );
}
