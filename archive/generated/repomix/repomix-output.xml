  if [[ "$rfd_status" -ne 0 ]]; then
    echo "assert failed: recover-feed-drift exited with $rfd_status" >&2
    echo "--- run.out ---" >&2
    cat "$rfd_dir/run.out" >&2
    echo "--- cast.log ---" >&2
