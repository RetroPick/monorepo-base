  chmod +x "$rfd_dir/bin/fake-broadcast-rfd"

  rfd_template_id="0x15de571597b78d4620f98fe88ceb62ebc3c88962dfff85a263ecfbe5f6d60676"

  set +e
  PATH="$rfd_dir/bin:$PATH" \
  NO_COLOR=1 \
