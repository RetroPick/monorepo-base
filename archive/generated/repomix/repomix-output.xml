  last_sent_at   TIMESTAMPTZ NOT NULL,
  sent_count     INT NOT NULL DEFAULT 1,
  suppressed_count INT NOT NULL DEFAULT 0
);

-- Deduplication window: 15 minutes for CRITICAL, 1 hour for HIGH, 6 hours for MEDIUM
