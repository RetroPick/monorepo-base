export enum EpochState {
  Scheduled = 0,
  Open = 1,
  Locked = 2,
  Resolved = 3,
  Cancelled = 4,
  Voided = 5,
}

/** `MarketTypes.MarketType` */
export enum MarketType {
  Direction = 0,
  Threshold = 1,
  RangeClose = 2,
  Velocity = 3,
  Ladder = 4,
  Convergence = 5,
  Composite = 6,
  Corridor = 7,
  Cascade = 8,
}

