#!/usr/bin/env bash
set -euo pipefail
out=""
url=""
method="GET"
data_file=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -o) out="${2:?}"; shift 2 ;;
    -w) shift 2 ;;
