      ;;
    -H|--max-time) shift 2 ;;
    -s|-S|-sS) shift ;;
    http*) url="$1"; shift ;;
    *) shift ;;
  esac
done
body='{}'
code=200
case "$url" in
  */api/v1/ops/tx/prepare)
    if [[ "$method" != "POST" ]]; then code=405; body='{"error":"method"}'; else
      fn=""
      args_repr=""
      if [[ -n "$data_file" && -f "$data_file" ]]; then
