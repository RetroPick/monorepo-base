@layer base {
  * {
    @apply border-border;
  }

  body {
    @apply bg-background text-foreground font-sans antialiased;
  }

  ::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }

  ::-webkit-scrollbar-track {
    background: hsl(var(--background));
  }

  ::-webkit-scrollbar-thumb {
    background: hsl(var(--border));
    border-radius: 3px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: hsl(var(--muted-foreground) / 0.45);
  }
}

@layer utilities {
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }

  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .glass-panel {
    background: hsl(var(--glass));
    backdrop-filter: blur(12px);
    border: 1px solid hsl(var(--glass-border));
  }

  .glass-panel:hover {
    background: hsl(var(--glass-hover));
    border-color: hsl(var(--border));
  }

  .dark .glass-panel:hover {
    border-color: hsl(0 0% 100% / 0.12);
  }

  .neon-glow-primary {
    box-shadow: 0 0 20px hsl(var(--primary) / 0.3);
  }

  .neon-glow-cyan {
    box-shadow: 0 0 15px hsl(var(--accent-cyan) / 0.3);
  }

  .neon-glow-green {
    box-shadow: 0 0 15px hsl(var(--accent-green) / 0.3);
  }

  .text-glow-green {
    text-shadow: 0 0 10px hsl(var(--accent-green) / 0.5);
  }

  .text-glow-rose {
    text-shadow: 0 0 10px hsl(var(--accent-magenta) / 0.5);
  }

  .text-glow-cyan {
    text-shadow: 0 0 10px hsl(var(--accent-cyan) / 0.5);
  }

  .neon-glow-rose {
    box-shadow: 0 0 15px hsl(var(--accent-magenta) / 0.3);
  }

  .bg-glass-gradient {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.05) 0%, rgba(255, 255, 255, 0.01) 100%);
  }

  .gradient-primary {
    background: linear-gradient(135deg, hsl(var(--primary)), hsl(217 91% 70%));
  }

  .font-display {
    font-family: "Plus Jakarta Sans", "Inter", sans-serif;
  }

  .text-gradient {
    @apply bg-clip-text text-transparent;
    background-image: linear-gradient(135deg, hsl(var(--primary)) 0%, hsl(var(--accent-cyan)) 50%, hsl(var(--ring)) 100%);
  }

  .text-gradient-animated {
    @apply inline-block bg-clip-text text-transparent bg-[length:200%_auto];
    background-image: linear-gradient(
      90deg,
      hsl(var(--primary)) 0%,
      hsl(var(--accent-cyan)) 25%,
      hsl(var(--accent-cyan)) 50%,
      hsl(var(--ring)) 75%,
      hsl(var(--accent-magenta)) 100%
    );
    animation: gradient-shift 4s ease-in-out infinite, glow-pulse-soft 2.5s ease-in-out infinite;
    filter: drop-shadow(0 0 10px hsl(var(--primary) / 0.22)) drop-shadow(0 0 20px hsl(var(--ring) / 0.12));
  }

  @keyframes gradient-shift {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  @keyframes glow-pulse-soft {
    0%, 100% {
      filter: drop-shadow(0 0 8px hsl(var(--primary) / 0.18)) drop-shadow(0 0 16px hsl(var(--ring) / 0.1));
    }
    50% {
      filter: drop-shadow(0 0 14px hsl(var(--primary) / 0.28)) drop-shadow(0 0 28px hsl(var(--ring) / 0.14));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .text-gradient-animated {
      animation: none;
      filter: none;
    }
  }

  @keyframes text-shimmer {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.85; }
  }

  .animate-text-shimmer {
    animation: text-shimmer 3s ease-in-out infinite;
  }
}
