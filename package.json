{
  "name": "retropick-v1",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "bin": {
    "retro": "bin/retro"
  },
  "scripts": {
    "retropick:deployer": "bash ./scripts/RETRODEPLOYER",
    "retropick:deploy": "bash ./scripts/RETRODEPLOYER deploy-all",
    "retro": "bash ./scripts/retro",
    "build": "pnpm -r build",
    "build:docs": "pnpm --filter docs build",
    "build:turbo-docs": "pnpm exec turbo --root-turbo-json turbo.repo.json run build --filter=docs",
    "contracts:registry": "node scripts/generate-contract-registry.mjs",
    "dev:fe-v1": "pnpm --filter fe-v1 dev",
    "dev:docs": "pnpm --filter docs dev",
    "dev:ops": "pnpm --filter ops dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r --if-present test",
    "cargo:check": "cargo check",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:up:desktop": "docker compose --env-file compose.desktop-hairpin.env up -d",
    "docker:down": "docker compose down -v"
  },
  "dependencies": {
    "@openzeppelin/contracts-upgradeable": "^5.6.1"
  },
  "devDependencies": {
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "turbo": "^2"
  }
}
