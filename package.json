{
  "name": "retropick-v1",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "bin": {
    "retro": "bin/retro"
  },
  "scripts": {
    "retropick:deployer": "bash ./scripts/RETRODEPLOYER",
    "retropick:deploy": "bash ./scripts/RETRODEPLOYER deploy-all",
    "retro": "bash ./scripts/retro",
    "dev": "pnpm exec turbo run dev --parallel",
    "build": "pnpm exec turbo run build",
    "build:docs": "pnpm --filter docs build",
    "build:turbo-docs": "pnpm exec turbo --root-turbo-json turbo.repo.json run build --filter=docs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm smoke",
    "clean": "pnpm exec turbo run clean",
    "contracts:registry": "node scripts/generate-contract-registry.mjs",
    "contracts:build": "forge build --root archive/contracts/legacy-pool-v1",
    "contracts:test": "forge test --root archive/contracts/legacy-pool-v1",
    "dev:web": "NEXT_PUBLIC_PRODUCT=markets pnpm --filter @retropick/markets-web dev",
    "dev:markets-stack": "bash scripts/markets-dev-up.sh",
    "dev:markets-stack:down": "bash scripts/markets-dev-down.sh",
    "smoke:markets-stack": "bash scripts/markets-dev-smoke.sh",
    "dev:docs": "pnpm --filter docs dev",
    "format": "pnpm exec prettier --check .",
    "lint": "pnpm exec turbo run lint",
    "typecheck": "pnpm exec turbo run typecheck",
    "test": "pnpm -r --if-present test",
    "verify": "pnpm lint && pnpm test && pnpm smoke",
    "smoke": "go -C apps/backend test ./...",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:up:desktop": "docker compose --env-file compose.desktop-hairpin.env up -d",
    "docker:down": "docker compose down -v"
  },
  "dependencies": {
    "@openzeppelin/contracts-upgradeable": "^5.6.1"
  },
  "devDependencies": {
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "turbo": "^2"
  },
  "pnpm": {
    "patchedDependencies": {
      "@reown/appkit-adapter-wagmi@1.8.19": "patches/@reown__appkit-adapter-wagmi@1.8.19.patch"
    }
  }
}
