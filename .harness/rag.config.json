{
  "include": [
    ".harness/**",
    ".dev/markets-v1/**",
    "schemas/openapi/markets-v1.yaml",
    "schemas/asyncapi/markets-realtime-v1.yaml",
    "apps/backend/internal/markets/**",
    "apps/backend/cmd/markets-api/**",
    "apps/web/src/products/markets/**",
    "packages/polymarket/**",
    "deploy/**",
    "ops/**",
    "docker/**",
    "AGENTS.md",
    "HARNESS.md",
    "PRODUCTION.md",
    "DECISIONS.md"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/.next/**",
    "**/dist/**",
    "**/out/**",
    "**/cache/**",
    "**/broadcast/**",
    "**/forge-out/**",
    "**/forge-std/**",
    "**/openzeppelin-contracts/**",
    "**/chainlink-brownie-contracts/**",
    "**/.turbo/**",
    "**/*.sqlite",
    "**/*.db",
    "**/*.log",
    "contracts/**",
    "apps/android/**",
    ".harness/state/**"
  ],
  "sourcePriority": {
    "manifest": 1,
    "projectContext": 2,
    "agents": 3,
    "obsidian": 4,
    "code": 5
  },
  "note": "Markets V1 release tasks prioritize .harness/** and .dev/markets-v1/** sources."
}
