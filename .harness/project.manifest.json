{
  "schema": "agent-harness.project.v1",
  "project": {
    "name": "retropick",
    "type": "markets-prediction-bff",
    "root": ".",
    "description": "RetroPick Markets V1 \u2014 Polymarket-native; Web (apps/web) + Android (RetroPick-Android) on a shared Go Markets BFF (apps/backend)."
  },
  "harness": {
    "mode": "release-factory",
    "canonicalRoots": {
      "monorepo": "/opt/retropick",
      "android": "/opt/retropick-android"
    },
    "worktrees": {
      "monorepo": "/opt/worktrees/retropick/<task-id>/",
      "android": "/opt/worktrees/retropick-android/<task-id>/"
    }
  },
  "kanban": {
    "board": "retropick-markets-release",
    "workspace": "dir:${projectRoot}"
  },
  "paths": {
    "product": [
      "apps/backend",
      "apps/web",
      "packages/polymarket",
      "schemas",
      "deploy",
      "docker"
    ],
    "docs": [
      "docs",
      ".dev/markets-v1"
    ],
    "scripts": [
      "scripts",
      ".harness/scripts"
    ],
    "tasks": ".harness/tasks",
    "state": ".harness/state",
    "marketsDocs": [
      ".dev/markets-v1"
    ]
  },
  "commands": {
    "dev": "NEXT_PUBLIC_PRODUCT=markets pnpm --filter @retropick/markets-web dev",
    "typecheck": "pnpm -r exec tsc --noEmit 2>/dev/null || pnpm build",
    "lint": "pnpm lint",
    "test": "pnpm test",
    "smoke": "pnpm smoke",
    "verify": "pnpm lint && pnpm test && pnpm smoke"
  },
  "agents": {
    "enabled": [
      "rp-release-orchestrator",
      "rp-recovery-architect",
      "rp-api-contract",
      "rp-backend-markets",
      "rp-web",
      "rp-android",
      "rp-qa-e2e",
      "rp-sre-release",
      "rp-review-security"
    ]
  },
  "skills": {
    "enabled": [
      "hermes-agent",
      "systematic-debugging",
      "tdd"
    ]
  },
  "rules": {
    "noSecrets": true,
    "requireTaskFile": true,
    "requireVerification": true,
    "archiveBeforeDelete": true,
    "noAutomaticMergeToMain": true,
    "maxRetries": 1
  },
  "products": {
    "marketsV1": {
      "docsRoot": ".dev/markets-v1",
      "manifest": ".harness/products/markets-v1/planning/implementation-manifest.yaml",
      "taskGraph": ".harness/products/markets-v1/planning/task-graph.yaml",
      "openApi": "schemas/openapi/markets-v1.yaml",
      "releasePolicy": ".harness/products/markets-v1/release",
      "evidenceRoot": ".harness/products/markets-v1/evidence"
    }
  },
  "android": {
    "monorepoGitlink": "apps/android",
    "externalCanonicalRepo": "git@github.com:RetroPick/RetroPick-Android.git",
    "gitlinkPolicy": "explicit SHA + validated evidence only (scripts/sync-android-gitlink.sh); never auto-follow upstream main"
  }
}
