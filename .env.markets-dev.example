# Copy to .env in repo root for local Markets stack BLK-001 rehearsal.
# .env is gitignored — never commit tokens or the session-secret value.
# Generate a secret with: openssl rand -hex 32
MARKETS_AUTH_SESSION_SECRET=
# Local dev only; set to the public origin used for the SIWE message.
MARKETS_AUTH_ALLOWED_DOMAINS=localhost

MARKETS_GEOIP_BASE_URL=https://ipinfo.io
MARKETS_GEOIP_PATH=/{ip}/json
MARKETS_GEOIP_API_KEY=

MARKETS_GEOBLOCK_BASE_URL=https://polymarket.com
MARKETS_GEOBLOCK_PATH=/api/geoblock
